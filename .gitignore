cat > /Users/subhash/Desktop/yo/.gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
backend/venv/

# Environment files
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.*
!.env.example

# Build output
dist/
frontend/dist/

# Database
*.db
*.sqlite
*.sqlite3

# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.swp
*.swo

# Node
node_modules/
npm-debug.log
yarn-error.log
EOF
.vercel
